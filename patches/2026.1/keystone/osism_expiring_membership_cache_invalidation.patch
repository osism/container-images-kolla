+
+"""Cached role assignments must follow expiring group memberships.
+
+An expiring group membership is valid or not depending on its last
+verification and the identity provider's authorization TTL. Two changes make
+an existing membership valid again without adding a new one, and both must
+invalidate the cached effective role assignments:
+
+- the identity provider's authorization TTL changes;
+- a federated login refreshes a membership that had expired.
+"""
+
+import datetime
+from unittest import mock
+import uuid
+
+from oslo_utils import timeutils
+
+from keystone.common import provider_api
+from keystone.common import sql
+from keystone.identity.backends import sql_model as model
+from keystone.tests import unit
+from keystone.tests.unit import default_fixtures
+from keystone.tests.unit.ksfixtures import database
+
+PROVIDERS = provider_api.ProviderAPIs
+
+
+class ExpiringMembershipCacheTest(unit.TestCase):
+    def setUp(self):
+        # Mock LDAP to avoid environment-specific errors, as the upstream
+        # federated group cache tests do.
+        ldap_patcher = mock.patch('ldap.initialize')
+        self.addCleanup(ldap_patcher.stop)
+        ldap_patcher.start()
+        with mock.patch('ldap.get_option', return_value=None):
+            with mock.patch('ldap.set_option'):
+                super().setUp()
+
+        self.useFixture(database.Database())
+        self.load_backends()
+
+        PROVIDERS.resource_api.create_domain(
+            default_fixtures.ROOT_DOMAIN['id'], default_fixtures.ROOT_DOMAIN
+        )
+        self.idp = {
+            'id': uuid.uuid4().hex,
+            'enabled': True,
+            'description': 'Test Identity Provider',
+        }
+        mapping = {'id': uuid.uuid4().hex, 'rules': []}
+        self.protocol = {
+            'id': uuid.uuid4().hex,
+            'idp_id': self.idp['id'],
+            'mapping_id': mapping['id'],
+        }
+        PROVIDERS.federation_api.create_idp(self.idp['id'], self.idp)
+        PROVIDERS.federation_api.create_mapping(mapping['id'], mapping)
+        PROVIDERS.federation_api.create_protocol(
+            self.idp['id'], self.protocol['id'], self.protocol
+        )
+        domain_id = PROVIDERS.federation_api.get_idp(self.idp['id'])[
+            'domain_id'
+        ]
+
+        group = unit.new_group_ref(domain_id=domain_id, name='members')
+        self.group = PROVIDERS.identity_api.create_group(group)
+        project = unit.new_project_ref(domain_id=domain_id)
+        self.project = PROVIDERS.resource_api.create_project(
+            project['id'], project
+        )
+        role = unit.new_role_ref(name='member')
+        self.role = PROVIDERS.role_api.create_role(role['id'], role)
+        PROVIDERS.assignment_api.create_grant(
+            self.role['id'],
+            group_id=self.group['id'],
+            project_id=self.project['id'],
+        )
+        self.user_ref = {
+            'id': uuid.uuid4().hex,
+            'name': 'federated-user',
+            'domain': {'id': domain_id},
+        }
+
+    def _login(self):
+        return PROVIDERS.identity_api.shadow_federated_user(
+            self.idp['id'],
+            self.protocol['id'],
+            self.user_ref,
+            group_ids=[self.group['id']],
+        )
+
+    def _role_ids(self, user_id):
+        assignments = PROVIDERS.assignment_api.list_role_assignments(
+            user_id=user_id, project_id=self.project['id'], effective=True
+        )
+        return [a['role_id'] for a in assignments]
+
+    def _age_memberships(self, minutes):
+        with sql.session_for_write() as session:
+            session.query(model.ExpiringUserGroupMembership).update(
+                {
+                    'last_verified': timeutils.utcnow()
+                    - datetime.timedelta(minutes=minutes)
+                }
+            )
+
+    def test_authorization_ttl_change_invalidates_assignments(self):
+        # No TTL: the membership written at login expires at once, and the
+        # empty result is cached.
+        user = self._login()
+        self._login()
+        self.assertEqual([], self._role_ids(user['id']))
+
+        PROVIDERS.federation_api.update_idp(
+            self.idp['id'], {'authorization_ttl': 1440}
+        )
+        self._login()
+
+        self.assertEqual([self.role['id']], self._role_ids(user['id']))
+
+    def test_unrelated_idp_update_keeps_assignments_cached(self):
+        PROVIDERS.federation_api.update_idp(
+            self.idp['id'], {'authorization_ttl': 1440}
+        )
+        user = self._login()
+        self.assertEqual([self.role['id']], self._role_ids(user['id']))
+
+        with mock.patch(
+            'keystone.assignment.core.COMPUTED_ASSIGNMENTS_REGION.invalidate'
+        ) as invalidate:
+            PROVIDERS.federation_api.update_idp(
+                self.idp['id'], {'description': 'changed'}
+            )
+            PROVIDERS.federation_api.update_idp(
+                self.idp['id'], {'authorization_ttl': 1440}
+            )
+        invalidate.assert_not_called()
+
+    def test_refreshing_an_expired_membership_invalidates_assignments(self):
+        PROVIDERS.federation_api.update_idp(
+            self.idp['id'], {'authorization_ttl': 60}
+        )
+        user = self._login()
+        # The membership lapses; a role lookup now caches the empty result.
+        self._age_memberships(120)
+        self.assertEqual([], self._role_ids(user['id']))
+
+        self._login()
+
+        self.assertEqual([self.role['id']], self._role_ids(user['id']))
+
+    def test_add_user_to_group_expires_reports_refreshed_expired_row(self):
+        PROVIDERS.federation_api.update_idp(
+            self.idp['id'], {'authorization_ttl': 60}
+        )
+        user = self._login()
+        shadow = PROVIDERS.shadow_users_api
+
+        self.assertFalse(
+            shadow.add_user_to_group_expires(user['id'], self.group['id'])
+        )
+        self._age_memberships(120)
+        self.assertTrue(
+            shadow.add_user_to_group_expires(user['id'], self.group['id'])
+        )
+        # Refreshed just now: valid again, so the next refresh is no change.
+        self.assertFalse(
+            shadow.add_user_to_group_expires(user['id'], self.group['id'])
+        )
