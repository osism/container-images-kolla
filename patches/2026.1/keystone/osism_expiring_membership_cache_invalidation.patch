 keystone/identity/shadow_backends/sql.py      |  10 +-
 .../unit/test_expiring_membership_cache.py    | 181 ++++++++++++++++++
 3 files changed, 204 insertions(+), 2 deletions(-)
 create mode 100644 keystone/tests/unit/test_expiring_membership_cache.py

diff --git a/keystone/federation/core.py b/keystone/federation/core.py
index e18cb3049..423f608fe 100644
--- a/keystone/federation/core.py
+++ b/keystone/federation/core.py
@@ -16,6 +16,7 @@ import uuid
 
 from oslo_log import log
 
+from keystone import assignment
 from keystone.common import cache
 from keystone.common import driver_hints
 from keystone.common import manager
@@ -92,6 +93,20 @@ class Manager(manager.Manager):
                 self._cleanup_idp_domain(idp['domain_id'])
             raise
 
+    def update_idp(self, idp_id, idp):
+        old_ttl = None
+        if 'authorization_ttl' in idp:
+            old_ttl = self.driver.get_idp(idp_id).get('authorization_ttl')
+        ref = self.driver.update_idp(idp_id, idp)
+        new_ttl = ref.get('authorization_ttl')
+        if 'authorization_ttl' in idp and new_ttl != old_ttl:
+            # Whether an expiring group membership is valid depends on the
+            # identity provider's authorization TTL, so a new TTL can make a
+            # user a group member, or stop being one, without any login.
+            # Role assignments computed from the old memberships are stale.
+            assignment.COMPUTED_ASSIGNMENTS_REGION.invalidate()
+        return ref
+
     def delete_idp(self, idp_id):
         self.driver.delete_idp(idp_id)
         # NOTE(lbragstad): If an identity provider is removed from the system,
