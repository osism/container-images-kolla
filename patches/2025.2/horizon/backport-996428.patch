@@ -1813,6 +1813,22 @@ Default: ``None``
 Allows to specify a callback to the IdP to cleanup the SSO resources.
 Once the user logs out it will redirect to the IdP log out method.

+WEBSSO_POST_LOGOUT_URL
+~~~~~~~~~~~~~~~~~~~~~~
+
+.. versionadded:: 2026.2(Hibiscus)
+
+Default: ``None``
+
+Once a WebSSO user's session has been terminated by the logout view, they
+will be redirected to the URL specified in this variable, instead of the
+login page. This only applies to users who authenticated via WebSSO (i.e.
+their session's ``auth_type`` is not ``credentials``).
+
+This is unrelated to ``LOGOUT_URL``, which just points the logout
+link/button at the logout view and does not by itself terminate the
+session.
+
 WEBSSO_KEYSTONE_URL
 ~~~~~~~~~~~~~~~~~~~

diff --git a/openstack_auth/defaults.py b/openstack_auth/defaults.py
index 41cfe539e..503b60b27 100644
--- a/openstack_auth/defaults.py
+++ b/openstack_auth/defaults.py
@@ -151,6 +151,16 @@ WEBSSO_DEFAULT_REDIRECT_REGION = OPENSTACK_KEYSTONE_URL
 # in this variable.
 WEBSSO_DEFAULT_REDIRECT_LOGOUT = None

+# Once a WebSSO user's session has been terminated by the logout view, they
+# will be redirected to the URL specified in this variable, instead of the
+# login page. This only applies to users who authenticated via WebSSO (i.e.
+# their session's auth_type is not 'credentials'); regular username/password
+# logins are unaffected and keep going to the login page.
+# Note this is unrelated to LOGOUT_URL, which just points the logout link/
+# button at the logout view and does not by itself terminate the session or
+# affect where the user ends up afterwards.
+WEBSSO_POST_LOGOUT_URL = None
+
 # If set this URL will be used for web single-sign-on authentication
 # instead of OPENSTACK_KEYSTONE_URL. This is needed in the deployment
 # scenarios where network segmentation is used per security requirement.
diff --git a/openstack_auth/tests/unit/test_auth.py b/openstack_auth/tests/unit/test_auth.py
index 21ac5a2f1..7ac29cb1b 100644
--- a/openstack_auth/tests/unit/test_auth.py
+++ b/openstack_auth/tests/unit/test_auth.py
@@ -994,6 +994,33 @@ class OpenStackAuthTestsWebSSO(test.TestCase):
         self.assertRedirects(response, settings.WEBSSO_DEFAULT_REDIRECT_LOGOUT,
                              status_code=302, target_status_code=301)

+    @override_settings(WEBSSO_POST_LOGOUT_URL='http://example.com/goodbye')
+    def test_logout_post_logout_url_redirect_websso_user(self):
+        settings.WEBSSO_POST_LOGOUT_URL = 'http://example.com/goodbye'
+
+        session = self.client.session
+        session['auth_type'] = 'oidc'
+        session.save()
+
+        url = reverse('logout')
+
+        response = self.client.get(url)
+        self.assertRedirects(response, settings.WEBSSO_POST_LOGOUT_URL,
+                             status_code=302, target_status_code=301)
+
+    @override_settings(WEBSSO_POST_LOGOUT_URL='http://example.com/goodbye')
+    def test_logout_post_logout_url_ignored_for_credentials_user(self):
+        settings.WEBSSO_POST_LOGOUT_URL = 'http://example.com/goodbye'
+
+        session = self.client.session
+        session['auth_type'] = 'credentials'
+        session.save()
+
+        url = reverse('logout')
+
+        response = self.client.get(url)
+        self.assertRedirects(response, settings.LOGIN_URL, status_code=302)
+

 class OpenStackAuthTests(test.TestCase):

diff --git a/openstack_auth/views.py b/openstack_auth/views.py
index 3c9898e27..f333aa1a8 100644
--- a/openstack_auth/views.py
+++ b/openstack_auth/views.py
@@ -264,6 +264,13 @@ def logout(request, login_url=None, **kwargs):
         return django_http.HttpResponseRedirect(
             settings.WEBSSO_DEFAULT_REDIRECT_LOGOUT)

+    session_auth_type = request.session.get('auth_type')
+    is_websso_user = (settings.WEBSSO_ENABLED and session_auth_type and
+                      session_auth_type != 'credentials')
+    if is_websso_user and settings.WEBSSO_POST_LOGOUT_URL:
+        auth_user.unset_session_user_variables(request)
+        return django_http.HttpResponseRedirect(settings.WEBSSO_POST_LOGOUT_URL)
+
     return django_auth_views.logout_then_login(request,
                                                login_url=login_url,
                                                **kwargs)
